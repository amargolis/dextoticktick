# Dex PRM API key (get from https://getdex.com)
DEX_API_KEY=your_dex_api_key_here

# TickTick OAuth credentials (create an app at https://developer.ticktick.com)
TICKTICK_CLIENT_ID=your_ticktick_client_id
TICKTICK_CLIENT_SECRET=your_ticktick_client_secret

# Optional overrides
# TICKTICK_REDIRECT_URI=http://localhost:8080/callback
# DATABASE_PATH=./job_search_data.db
# SYNC_INTERVAL_SECONDS=60
# RATE_LIMIT_DELAY=1500
